{
  "name": "findable",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run generate --filter=@repo/db",
    "db:migrate": "turbo run migrate --filter=@repo/db",
    "db:deploy": "turbo run deploy --filter=@repo/db",
    "db:studio": "turbo run studio --filter=@repo/db",
    "db:seed": "turbo run seed --filter=@repo/db",
    "qdrant:init": "turbo run qdrant:init --filter=@repo/rag"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.7"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
