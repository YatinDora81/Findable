{
  "name": "@repo/db",
  "version": "0.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "generate": "bun --env-file=../../.env --bun run prisma generate",
    "migrate": "bun --env-file=../../.env --bun run prisma migrate dev",
    "deploy": "bun --env-file=../../.env --bun run prisma migrate deploy",
    "studio": "bun --env-file=../../.env --bun run prisma studio",
    "seed": "bun --env-file=../../.env prisma/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.22.0"
  }
}
