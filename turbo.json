{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "QDRANT_URL",
    "QDRANT_API_KEY",
    "QDRANT_COLLECTION",
    "GEMINI_API_KEYS",
    "EMBEDDING_MODEL",
    "EMBEDDING_DIMENSIONS",
    "GENERATION_MODEL",
    "UTILITY_MODEL",
    "PORT",
    "WEB_ORIGIN",
    "LOG_LEVEL",
    "NODE_ENV",
    "MAX_CONTENT_BYTES",
    "FETCH_TIMEOUT_MS",
    "RETRIEVAL_TOP_K",
    "SCORE_THRESHOLD",
    "INGEST_CONCURRENCY",
    "WORKER_PORT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WORKER_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "cache": false
    },
    "qdrant:init": {
      "cache": false
    }
  }
}
